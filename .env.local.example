WOOCOMMERCE_URL=http://tatsmood.local
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Secreto de los webhooks de WooCommerce (app/api/revalidate). Inventa uno largo y
# pon el mismo en WooCommerce → Ajustes → Avanzado → Webhooks.
WC_WEBHOOK_SECRET=

# Para los avisos de WordPress (contenidos), pon el mismo valor en wp-config.php:
#   define( 'TATSMOOD_REVALIDATE_SECRET', '...' );

# Dirección pública de la web (SEO: enlaces canónicos, sitemap, imágenes para redes). En producción: https://tatsmood.com
SITE_URL=http://localhost:3000
